# ==============================================================================
# 🛡️ Zelsis SaaS - Environment Configuration Template (.env.example)
# Copy this file to `.env.local` for local development.
# NEVER commit real secret credentials, API keys, or JWT tokens to version control.
# ==============================================================================

# Application Environment & Server
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 📦 Supabase Cloud Database & Authentication (SEC-03, SEC-04, SEC-11)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only: used for administrative tasks and webhook operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# ⚡ Upstash Redis - Distributed Sliding-Window Rate Limiter (SEC-05)
# ------------------------------------------------------------------------------
# If omitted, Zelsis seamlessly falls back to the in-memory sliding window limiter
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ------------------------------------------------------------------------------
# 💳 Polar Payments & Webhooks (Active Merchant of Record)
# ------------------------------------------------------------------------------
# Obtain from Polar Dashboard -> Settings -> Developers (https://polar.sh/dashboard/settings)
POLAR_ACCESS_TOKEN=polar_at_placeholder_token
POLAR_WEBHOOK_SECRET=polar_whsec_placeholder_secret

# ------------------------------------------------------------------------------
# 💳 Stripe Payments & Webhooks (Secondary / Alternative Provider)
# ------------------------------------------------------------------------------
# Obtain from Stripe Dashboard -> Developers -> API keys & Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
# Stripe CLI or Dashboard Webhook Endpoint Secret (begins with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# ------------------------------------------------------------------------------
# 🐙 GitHub API Integration (SEC-02, SEC-07)
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (PAT) to increase GitHub REST API rate limits (60/hr -> 5,000/hr)
GITHUB_TOKEN=ghp_placeholder_token

# ------------------------------------------------------------------------------
# 🌐 Network Security & CORS Whitelist (SEC-08)
# ------------------------------------------------------------------------------
# Production client URL allowed for API access (blocks unauthorized cross-origin requests)
PRODUCTION_CLIENT_URL=https://zelsis.com

# ------------------------------------------------------------------------------
# 📢 Notification Webhook Integrations (SEC-19)
# ------------------------------------------------------------------------------
# Optional incoming webhook URLs for automated release gate alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000000000/XXXXX

# ------------------------------------------------------------------------------
# 👑 Platform Administrators & Founders (SEC-15)
# ------------------------------------------------------------------------------
# Comma-separated list of administrative email addresses (Server-side ONLY)
ADMIN_EMAILS=admin@example.com

